{{! Seavan Academy workspace; GPL v3 or later. }}
{{> theme_boost/head }}
<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper }}
<div id="page-wrapper" class="sa-frame{{#managementmode}} sa-management{{/managementmode}}">
    {{{ output.standard_top_of_body_html }}}
    <header class="sa-header">
        <div class="sa-header-inner">
            <a href="{{home}}" class="sa-brand" aria-label="خانه آکادمی سیوان">
                <img src="{{logo}}" alt="سیوان" width="134">
                <span class="sa-brand-label">{{#managementmode}}مرکز مدیریت{{/managementmode}}{{^managementmode}}آکادمی{{/managementmode}}</span>
            </a>
            <nav class="sa-main-nav" aria-label="منوی اصلی">
                {{#links}}
                <a href="{{url}}" {{#active}}aria-current="page"{{/active}}>
                    <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    {{#library}}<rect x="3" y="4" width="18" height="16" rx="3"/><path d="m10 8 6 4-6 4Z"/>{{/library}}
                    {{#learning}}<path d="M5 4h14v16l-7-4-7 4z"/><path d="m9 10 2 2 4-4"/>{{/learning}}
                    {{#management}}<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>{{/management}}
                    </svg><span>{{text}}</span>
                </a>
                {{/links}}
            </nav>
            <div class="sa-header-tools"><button type="button" id="sa-dark" class="sa-dark-toggle" aria-label="تغییر حالت روشن یا تاریک" aria-pressed="false"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.5 15.2A9 9 0 0 1 8.8 3.5a9 9 0 1 0 11.7 11.7Z"/></svg></button>
            <div id="usernavigation" class="sa-account usermenu-container" data-region="usermenu">
                {{{ output.navbar_plugin_output }}}
                {{#usermenu}}{{> core/user_menu }}{{/usermenu}}
            </div></div>
        </div>
    </header>
    <div id="page" data-region="mainpage" class="sa-page">
        <div id="topofscroll" class="sa-content">
            <div id="page-content">
                <div id="region-main-box">
                    <main id="region-main" class="sa-main" aria-label="محتوای آکادمی">
                        {{{ output.course_content_header }}}
                        {{{ output.main_content }}}
                        {{{ output.course_content_footer }}}
                    </main>
                </div>
            </div>
        </div>
        <footer id="page-footer" class="sa-footer">
            <span>آکادمی سیوان · آموزش داخلی شرکت</span>
            {{{ output.standard_footer_html }}}
            {{{ output.debug_footer_html }}}
        </footer>
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
const darkbutton=document.getElementById('sa-dark');
if(darkbutton){
  const apply=dark=>{document.body.classList.toggle('sa-dark',dark);darkbutton.setAttribute('aria-pressed',String(dark));};
  try{apply(localStorage.getItem('sa-dark')==='1');}catch(e){}
  darkbutton.addEventListener('click',()=>{const dark=!document.body.classList.contains('sa-dark');apply(dark);try{localStorage.setItem('sa-dark',dark?'1':'0');}catch(e){}});
}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() { M.util.js_complete('theme_boost/loader'); });
{{/js}}
